{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "agent-live.config.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project": { "type": "string", "description": "Name shown in the top bar." },
    "port": { "type": "integer", "minimum": 1, "maximum": 65535, "description": "Port of the Agent Live page." },
    "relayUrl": { "type": "string", "pattern": "^https?://", "description": "Where the agent-flow relay listens." },
    "agentsDirs": { "type": "array", "items": { "type": "string" }, "description": "Folders with agent .md files, relative to the project." },
    "claude": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "configDirs": { "type": "array", "items": { "type": "string" }, "description": "Claude Code config folders. Default: CLAUDE_CONFIG_DIR, ~/.claude and ~/.claude-*." },
        "extraProjectPaths": { "type": "array", "items": { "type": "string" }, "description": "More project folders (for example git worktrees) whose sessions belong to this team." },
        "projectMatch": { "type": "string", "description": "Optional regex on Claude's encoded project folder name; matching folders are included." }
      }
    },
    "accounts": {
      "type": "array", "description": "Optional labels for sessions, by the encoded project folder name.",
      "items": { "type": "object", "required": ["match", "label"], "additionalProperties": false,
        "properties": { "match": { "type": "string" }, "label": { "type": "string" } } }
    },
    "human": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "role": { "type": "string" } }
    },
    "orchestrator": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "role": { "type": "string" },
        "byAccount": { "type": "object", "description": "account label -> node id of another main-session node", "additionalProperties": { "type": "string" } } }
    },
    "jobs": {
      "type": "object", "additionalProperties": false, "description": "Optional: show headless background runs (one pid file per run) as live sessions.",
      "properties": { "pidDirs": { "type": "array", "items": { "type": "string" }, "description": "Folders inside the project with one <name>.pid file per running job." } }
    },
    "relayNode": { "type": "string", "description": "Node id lit green while the relay answers. Empty = none." },
    "bands": {
      "type": "object", "description": "band id -> label and colour",
      "additionalProperties": { "type": "object", "additionalProperties": false,
        "properties": { "label": { "type": "string" }, "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" } } }
    },
    "stages": {
      "type": "array", "minItems": 1, "description": "Columns of the map: [id, label] pairs.",
      "items": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "string" } }
    },
    "nodes": {
      "type": "array", "description": "Boxes on the map. Empty = built from the agents folder.",
      "items": { "type": "object", "required": ["id", "name", "band"], "additionalProperties": false,
        "properties": { "id": { "type": "string" }, "name": { "type": "string" }, "band": { "type": "string" }, "stage": { "type": "string" },
          "role": { "type": "string" }, "cost": { "type": "string" }, "lane": { "type": "string" }, "sees": { "type": "string" } } }
    },
    "edges": {
      "type": "array", "items": { "type": "array", "minItems": 2, "maxItems": 3, "items": { "type": "string" } },
      "description": "[from, to] or [from, to, label] (a label makes it a dashed side link)."
    },
    "useDefaultRules": { "type": "boolean" },
    "activityRules": {
      "type": "array", "description": "Your own rules: regex on tool name and argument text -> node id.",
      "items": { "type": "object", "required": ["node"], "additionalProperties": false,
        "properties": { "node": { "type": "string" }, "tool": { "type": "string" }, "match": { "type": "string" }, "flags": { "type": "string" }, "waiting": { "type": "boolean" } } }
    },
    "history": {
      "type": "object", "additionalProperties": false,
      "properties": { "file": { "type": "string" }, "ring": { "type": "integer", "minimum": 100, "maximum": 100000 }, "maxLines": { "type": "integer", "minimum": 100 } }
    },
    "keepFinishedMinutes": { "type": "integer", "minimum": 1 },
    "telemetry": { "type": "boolean", "description": "Leave false: the relay is started with telemetry off." }
  }
}
